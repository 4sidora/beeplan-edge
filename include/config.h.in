#pragma once

/** MAC концентратора ESP-NOW (6 байт). */
static const uint8_t GATEWAY_MAC[6] = { {{GATEWAY_MAC_BYTES}} };

/** Публичный идентификатор устройства (как в BeePlan API). */
#define DEVICE_PUBLIC_ID "{{DEVICE_PUBLIC_ID}}"

/** Интервал между циклами измерения (секунды). */
#define WAKE_INTERVAL_SEC {{WAKE_INTERVAL_SEC}}

/** Wi‑Fi канал концентратора (1–13, обязателен в v2). */
#define GATEWAY_WIFI_CHANNEL {{GATEWAY_WIFI_CHANNEL}}

/** Тип устройства: 0=multisensor, 1=scales. */
#define DEVICE_TYPE {{DEVICE_TYPE}}

/** HX711 (TZT module): DOUT и SCK. Для multisensor — 0 (не используется). */
#define HX711_DOUT_PIN {{HX711_DOUT_PIN}}
#define HX711_SCK_PIN {{HX711_SCK_PIN}}

/** DS18B20 для компенсации температурного дрейфа тензодатчика. */
#define DS18B20_PIN {{DS18B20_PIN}}

/** 1 — взвешивание половины массы (×2 в отчёте); 0 — полный вес. */
#define WEIGHT_MODE_HALF {{WEIGHT_MODE_HALF}}

/** Semver (0.1.2). */
#define FIRMWARE_VERSION "{{FIRMWARE_VERSION}}"

/** Полное имя в Serial: beeplan-Edge-0.1.2 */
#define FIRMWARE_SERIAL_TAG "{{FIRMWARE_SERIAL_TAG}}"

/** 1 — подробный UART-лог; 0 — без задержки serial при boot. */
#define BEEPLAN_DEBUG {{BEEPLAN_DEBUG}}
